{
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://akashpriyadarshii.github.io" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, x-admin-secret" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/((?!api/).*)",
      "destination": "https://akashpriyadarshii.github.io/My-Starred-Repos/$1",
      "permanent": false
    }
  ]
}
